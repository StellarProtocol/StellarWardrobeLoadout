<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.WardrobeLoadout</RootNamespace>
    <AssemblyName>Stellar.WardrobeLoadout</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Consumes IWardrobe (framework 2.4.0). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.4.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json" LogicalName="Stellar.WardrobeLoadout.Lang.en.json" />
  </ItemGroup>
  <!-- The unit-test project is a sibling folder under this repo root; keep its sources out of the
       plugin's default `**/*.cs` glob (else its xUnit test files + generated obj land in the plugin). -->
  <ItemGroup>
    <Compile Remove="Stellar.WardrobeLoadout.Tests/**/*.cs" />
    <EmbeddedResource Remove="Stellar.WardrobeLoadout.Tests/**/*" />
    <None Remove="Stellar.WardrobeLoadout.Tests/**/*" />
  </ItemGroup>
</Project>
