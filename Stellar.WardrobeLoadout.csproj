<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.WardrobeLoadout</RootNamespace>
    <AssemblyName>Stellar.WardrobeLoadout</AssemblyName>
    <Version>1.2.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Consumes IWardrobe incl. the weapon-skin API (GetWornWeaponSkin / ApplyWeaponSkinAsync) and
         VirtualListElement — framework 2.6.0. Bumped to the local dev prerelease for
         IPlayerIdentity.CharId (Task 1); the release train will land on the real published version. -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.6.3-charid-dev" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.0.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json"  LogicalName="Stellar.WardrobeLoadout.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json"  LogicalName="Stellar.WardrobeLoadout.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json"  LogicalName="Stellar.WardrobeLoadout.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json"  LogicalName="Stellar.WardrobeLoadout.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.WardrobeLoadout.Lang.fil.json" />
    <!-- Launcher tile icon (clothes hanger) — white+alpha, tinted by the launcher. -->
    <EmbeddedResource Include="wardrobe-icon.png" LogicalName="Stellar.WardrobeLoadout.wardrobe-icon.png" />
    <!-- Row-action icons — one bold uniform set (white+alpha PNGs, tinted with the theme text colour by
         the framework). The overlay font can't provide most of these cleanly at this size/weight. -->
    <EmbeddedResource Include="Icons/edit.png"    LogicalName="Stellar.WardrobeLoadout.Icons.edit.png" />
    <EmbeddedResource Include="Icons/save.png"    LogicalName="Stellar.WardrobeLoadout.Icons.save.png" />
    <EmbeddedResource Include="Icons/refresh.png" LogicalName="Stellar.WardrobeLoadout.Icons.refresh.png" />
    <EmbeddedResource Include="Icons/up.png"      LogicalName="Stellar.WardrobeLoadout.Icons.up.png" />
    <EmbeddedResource Include="Icons/down.png"    LogicalName="Stellar.WardrobeLoadout.Icons.down.png" />
    <EmbeddedResource Include="Icons/apply.png"   LogicalName="Stellar.WardrobeLoadout.Icons.apply.png" />
    <EmbeddedResource Include="Icons/trash.png"   LogicalName="Stellar.WardrobeLoadout.Icons.trash.png" />
    <EmbeddedResource Include="Icons/cancel.png"  LogicalName="Stellar.WardrobeLoadout.Icons.cancel.png" />
  </ItemGroup>
  <!-- The unit-test project is a sibling folder under this repo root; keep its sources out of the
       plugin's default `**/*.cs` glob (else its xUnit test files + generated obj land in the plugin). -->
  <ItemGroup>
    <Compile Remove="Stellar.WardrobeLoadout.Tests/**/*.cs" />
    <EmbeddedResource Remove="Stellar.WardrobeLoadout.Tests/**/*" />
    <None Remove="Stellar.WardrobeLoadout.Tests/**/*" />
  </ItemGroup>
</Project>
