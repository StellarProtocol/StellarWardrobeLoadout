<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.WardrobeLoadout</RootNamespace>
    <AssemblyName>Stellar.WardrobeLoadout</AssemblyName>
    <Version>1.5.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Consumes IWardrobe incl. the weapon-skin API (GetWornWeaponSkin / ApplyWeaponSkinAsync) and
         IPlayerIdentity.CharId (per-character outfits). 2.30.0 for the house-style window: BubbleElement fills /
         outlines, VirtualListElement.OnReorder + FixedHeight, ImageElement.Tint, theme status colours
         (Success / Danger / Caution), WindowSpec.TitleProvider / Prebuild, HotkeyAction.IsActive.
         2.31.0 for IWardrobePreviewOptions (preview ShowWeapon + the outfit's own show/hide state). -->
    <PackageReference Include="Stellar.Abstractions"       Version="2.31.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.31.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.31.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Lang/en.json"  LogicalName="Stellar.WardrobeLoadout.Lang.en.json" />
    <EmbeddedResource Include="Lang/ja.json"  LogicalName="Stellar.WardrobeLoadout.Lang.ja.json" />
    <EmbeddedResource Include="Lang/th.json"  LogicalName="Stellar.WardrobeLoadout.Lang.th.json" />
    <EmbeddedResource Include="Lang/id.json"  LogicalName="Stellar.WardrobeLoadout.Lang.id.json" />
    <EmbeddedResource Include="Lang/fil.json" LogicalName="Stellar.WardrobeLoadout.Lang.fil.json" />
    <EmbeddedResource Include="Lang/ko.json"  LogicalName="Stellar.WardrobeLoadout.Lang.ko.json" />
    <!-- Launcher tile icon ("D — Armoire" wardrobe, tools/armoire.py 128 px drawing) — white+alpha, tinted by the launcher. -->
    <EmbeddedResource Include="wardrobe-icon.png" LogicalName="Stellar.WardrobeLoadout.wardrobe-icon.png" />
    <!-- Window glyphs (armoire, pencil, refresh, check, close, grip): white flat PNGs, one pre-drawn bitmap per
         on-screen size (tools/gen_icons.py → Icons/<name>-<px>.png), tinted with theme colours at draw time. -->
    <EmbeddedResource Include="Icons/*.png" LogicalName="Stellar.WardrobeLoadout.Icons.%(Filename).png" />
  </ItemGroup>
  <!-- The unit-test project is a sibling folder under this repo root; keep its sources out of the
       plugin's default `**/*.cs` glob (else its xUnit test files + generated obj land in the plugin). -->
  <ItemGroup>
    <Compile Remove="Stellar.WardrobeLoadout.Tests/**/*.cs" />
    <EmbeddedResource Remove="Stellar.WardrobeLoadout.Tests/**/*" />
    <None Remove="Stellar.WardrobeLoadout.Tests/**/*" />
  </ItemGroup>
</Project>
